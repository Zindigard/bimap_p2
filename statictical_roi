fig, (ax1, ax2) = plt.subplots(1, 2)

def plot_distribution(ax, data1, data2, xlabel, color1='#1f77b4', color2='#ff7f0e'):
    """Plot KDE distributions for two datasets"""
    kde1 = gaussian_kde(data1)
    kde2 = gaussian_kde(data2)
    
    combined = data1 + data2
    x_min = min(combined) - 0.1*(max(combined)-min(combined))
    x_max = max(combined) + 0.1*(max(combined)-min(combined))
    x = np.linspace(x_min, x_max, 500)
    
    ax.plot(x, kde1(x), color=color1, label='Host')
    ax.plot(x, kde2(x), color=color2, label='Lab')
    ax.fill_between(x, kde1(x), color=color1, alpha=0.2)
    ax.fill_between(x, kde2(x), color=color2, alpha=0.2)
    
    ax.axvline(np.mean(data1), color=color1, linestyle='--', linewidth=1, alpha=0.7)
    ax.axvline(np.mean(data2), color=color2, linestyle='--', linewidth=1, alpha=0.7)
    
    ax.text(0.95, 0.95, f'μ = {np.mean(data1):.4f}', 
            transform=ax.transAxes, ha='right', va='top', color=color1,
            bbox=dict(facecolor='white', alpha=0.7, pad=2, edgecolor='none'))
    ax.text(0.95, 0.85, f'μ = {np.mean(data2):.4f}', 
            transform=ax.transAxes, ha='right', va='top', color=color2,
            bbox=dict(facecolor='white', alpha=0.7, pad=2, edgecolor='none'))
    
    ax.set_xlabel(xlabel)
    ax.set_ylabel('Probability Density')
    ax.legend(frameon=False, loc='best')


plot_distribution(ax1, roi1_gr, roi2_gr, 'Growth Rate (µm/min)')
