def read_growth_data(file_path):
    """Read growth rate data from file"""
    growth_rates = []
    lengths = []
    
    with open(file_path, 'r') as f:
        header = None
        for line in f:
            if line.startswith('#'):
                continue
            if 'Cell_ID' in line or 'Growth_Rate' in line:
                header = line.strip().split('\t')
                break
        
        f.seek(0)
        reader = csv.reader(f, delimiter='\t')
        for row in reader:
            if not row or row[0].startswith('#') or 'Cell_ID' in row[0]:
                continue
            try:
                growth_rates.append(float(row[1]))
                lengths.append(float(row[2]))
            except (ValueError, IndexError):
                continue
    
    return growth_rates, lengths

data_dir = r"C:\Users\zindi\PycharmProjects\P2\Evaluations\SAM"


