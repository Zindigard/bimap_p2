import os
import numpy as np
import pandas as pd
from pathlib import Path
from skimage import io
from skimage.util import img_as_float32
from skimage.metrics import peak_signal_noise_ratio, structural_similarity
from n2v.models import N2V, N2VConfig
import warnings
from typing import List, Dict

def get_project_root():
    """
    Get the root directory where scripts are located.
    
    Returns:
        str: Absolute path to the directory containing this script
    """
    return os.path.dirname(os.path.abspath(__file__))

def setup_folders():
    """
    Create necessary folder structure for N2V denoising pipeline.
    
    Returns:
        dict: Dictionary with paths to all required folders
    """
    root_dir = get_project_root()
    
    folders = {
        'input': os.path.join(root_dir, "test_data"),
        'output': os.path.join(root_dir, "denoised_results"),
        'models': os.path.join(root_dir, "models")
    }
    
    for folder in folders.values():
        os.makedirs(folder, exist_ok=True)
        print(f"Ensured folder exists: {folder}")
    
    return folders

def normalize_image(img: np.ndarray) -> np.ndarray:
    """
    Normalize image to float32 [0,1] range based on data type.
    
    Args:
        img (np.ndarray): Input image array of any data type
        
    Returns:
        np.ndarray: Normalized image in [0,1] float32 range
    """
    if img.dtype == np.uint16:
        img = img.astype(np.float32) / 65535.0
    elif img.dtype == np.uint8:
        img = img.astype(np.float32) / 255.0
    else:
        img = img_as_float32(img)
    
    img = np.clip(img, 0.0, 1.0)
    return img

def merge_channels(channels: list[np.ndarray]) -> np.ndarray:
    """
    Merge multiple 2D channels into a single 2D image by concatenating along width.
    
    Args:
        channels (list): List of 2D channel arrays to merge
        
    Returns:
        np.ndarray: Single merged image with all channels side by side
        
    Note:
        Automatically resizes channels to common height if they differ
    """
    heights = [ch.shape[0] for ch in channels]
    if len(set(heights)) > 1:
        min_height = min(heights)
        resized_channels = []
        for ch in channels:
            if ch.shape[0] != min_height:
                from skimage.transform import resize
                ch = resize(ch, (min_height, ch.shape[1]), preserve_range=True)
            resized_channels.append(ch)
        channels = resized_channels
    
    merged = np.concatenate(channels, axis=1)
    return merged

def split_merged_image(merged: np.ndarray, original_channels: list[np.ndarray]) -> list[np.ndarray]:
    """
    Split a merged image back into individual channels based on original widths.
    
    Args:
        merged (np.ndarray): Merged image containing all channels
        original_channels (list): Original channel arrays for width reference
        
    Returns:
        list: List of separated channel arrays
    """
    split_channels = []
    current_pos = 0
    
    for ch in original_channels:
        width = ch.shape[1]
        split_ch = merged[:, current_pos:current_pos + width]
        split_channels.append(split_ch)
        current_pos += width
    
    return split_channels

def train_n2v_on_merged(merged_img: np.ndarray, model_name: str, config_params: Dict,
                        basedir: str | Path) -> np.ndarray:
    """
    Train Noise2Void model on merged multi-channel image for self-supervised denoising.
    
    Args:
        merged_img (np.ndarray): Merged image in float32 [0,1] range
        model_name (str): Name for the trained model
        config_params (dict): Training configuration parameters
        basedir (str|Path): Directory to save model files
        
    Returns:
        np.ndarray: Denoised merged image in float32 [0,1] range
        
    Process:
        1. Extract random patches from merged image
        2. Train N2V model on patches
        3. Apply model to full image with padding for even dimensions
        4. Crop back to original size
    """
    os.makedirs(basedir, exist_ok=True)

    rng = np.random.default_rng(42)
    height, width = merged_img.shape
    patch_height, patch_width = config_params['patch_size']
    patches = []
    for _ in range(config_params['n_patches']):
        top  = rng.integers(0, max(1, height - patch_height))
        left = rng.integers(0, max(1, width - patch_width))
        patches.append(merged_img[top:top+patch_height, left:left+patch_width][..., None])
    patches = np.stack(patches).astype(np.float32)  # (N, patch_height, patch_width, 1)

    n_val = int(len(patches) * config_params['val_split'])
    val_X, tr_X = patches[:n_val], patches[n_val:]

    # Configure N2V model
    config = N2VConfig(
        X=patches, axes='YXC',
        unet_kern_size=3,
        train_steps_per_epoch=config_params['steps_per_epoch'],
        train_epochs=config_params['train_epochs'], train_loss='mse',
        batch_norm=True, train_batch_size=config_params['batch_size'],
        n2v_perc_pix=0.198, n2v_patch_shape=config_params['patch_size'],
        train_learning_rate=config_params['learning_rate'],
        train_reduce_lr=config_params['reduce_lr']
    )
    
    # Initialize and train model
    n2v = N2V(config=config, name=model_name, basedir=str(basedir))
    n2v.train(tr_X, val_X, epochs=config_params['train_epochs'], 
              steps_per_epoch=config_params['steps_per_epoch'])

    # Pad image to multiple of 4 for model compatibility
    height, width = merged_img.shape
    multiple = 4
    new_height = ((height + multiple - 1) // multiple) * multiple
    new_width = ((width + multiple - 1) // multiple) * multiple
    pad_height = new_height - height
    pad_width = new_width - width
    top = pad_height // 2
    bottom = pad_height - top
    left = pad_width // 2
    right = pad_width - left
    
    if pad_height or pad_width:
        pad_img = np.pad(merged_img, ((top, bottom), (left, right)), mode='reflect')
        crop = (slice(top, top + height), slice(left, left + width))
    else:
        pad_img = merged_img
        crop = (slice(0, height), slice(0, width))

    # Predict and crop back to original size
    pred_full = n2v.predict(pad_img, axes='YX').astype(np.float32)
    pred = pred_full[crop]
    return normalize_image(pred)

def calculate_quality_metrics(original: np.ndarray, denoised: np.ndarray) -> Dict:
    """
    Calculate comprehensive quality metrics between original and denoised images.
    
    Args:
        original (np.ndarray): Original image array
        denoised (np.ndarray): Denoised image array
        
    Returns:
        dict: Dictionary containing:
            - mse: Mean Squared Error
            - psnr: Peak Signal-to-Noise Ratio (dB)
            - ssim: Structural Similarity Index
            - ncc: Normalized Cross-Correlation
    """
    metrics = {}
    data_range = 1.0

    metrics['mse'] = np.mean((original - denoised) ** 2)
    metrics['psnr'] = peak_signal_noise_ratio(original, denoised, data_range=data_range)
    metrics['ssim'] = structural_similarity(original, denoised, data_range=data_range)
    
    # Normalized cross-correlation
    metrics['ncc'] = np.corrcoef(original.ravel(), denoised.ravel())[0, 1]
    
    return metrics

def save_metrics_to_txt(metrics: Dict, file_path: Path, mode: str = 'a'):
    """
    Save metrics dictionary to a text file in readable format.
    
    Args:
        metrics (dict): Metrics dictionary to save
        file_path (Path): Path to output text file
        mode (str): File write mode ('a' for append, 'w' for write)
    """
    with open(file_path, mode) as f:
        f.write("\n=== Image Metrics ===\n")
        for key, value in metrics.items():
            if isinstance(value, list):
                f.write(f"{key}: {[f'{x:.4f}' for x in value]}\n")
            else:
                f.write(f"{key}: {value:.4f}\n")
        f.write("\n")

def save_summary_to_txt(results: List[Dict], file_path: Path):
    """
    Save aggregated statistics across all processed images.
    
    Args:
        results (list): List of metric dictionaries
        file_path (Path): Path to output summary file
    """
    if not results:
        return

    ssim_values = [x['ssim'] for x in results]
    psnr_values = [x['psnr'] for x in results]
    mse_values = [x['mse'] for x in results]

    with open(file_path, 'w') as f:
        f.write("=== Final Summary Statistics ===\n\n")
        f.write(f"Total Images Processed: {len(results)}\n\n")

        f.write("SSIM Statistics:\n")
        f.write(f"- Average: {np.mean(ssim_values):.4f}\n")
        f.write(f"- Median: {np.median(ssim_values):.4f}\n")
        f.write(f"- Range: [{np.min(ssim_values):.4f}, {np.max(ssim_values):.4f}]\n")
        f.write(f"- Std Dev: {np.std(ssim_values):.4f}\n\n")

        f.write("PSNR Statistics:\n")
        f.write(f"- Average: {np.mean(psnr_values):.2f} dB\n")
        f.write(f"- Median: {np.median(psnr_values):.2f} dB\n")
        f.write(f"- Range: [{np.min(psnr_values):.2f}, {np.max(psnr_values):.2f}] dB\n")
        f.write(f"- Std Dev: {np.std(psnr_values):.2f}\n\n")

        f.write("MSE Statistics:\n")
        f.write(f"- Average: {np.mean(mse_values):.6f}\n")
        f.write(f"- Median: {np.median(mse_values):.6f}\n")
        f.write(f"- Range: [{np.min(mse_values):.6f}, {np.max(mse_values):.6f}]\n")
        f.write(f"- Std Dev: {np.std(mse_values):.6f}\n")

def process_single_image_n2v(image_array: np.ndarray, config_params: Dict,
                            model_name: str = "N2V_merged") -> tuple:
    """
    Complete N2V denoising pipeline for a single multi-channel image.
    
    Args:
        image_array (np.ndarray): Input image with shape (X, Y, C)
        config_params (dict): N2V training configuration parameters
        model_name (str): Base name for the trained model
        
    Returns:
        tuple: (denoised_channels, channel_metrics, image_metrics)
            - denoised_channels: List of denoised individual channels
            - channel_metrics: List of metrics for each channel
            - image_metrics: Aggregated metrics across all channels
    """
    if image_array.ndim != 3:
        raise ValueError(f"Expected 3D array (X, Y, C), got {image_array.shape}")
    image_array = np.moveaxis(image_array, -1, 0)
    
    channels = [normalize_image(image_array[i]) for i in range(image_array.shape[0])]
    channel_names = [f'Channel_{i}' for i in range(image_array.shape[0])]
    
    merged = merge_channels(channels)
    
    print(f"\n[TRAIN N2V on merged channels]")
    denoised_merged = train_n2v_on_merged(merged, model_name, config_params, config_params['base_model_dir'])
    
    denoised_channels = split_merged_image(denoised_merged, channels)
    
    metrics = []
    all_channel_metrics = []
    
    for ch_name, raw_ch, den_ch in zip(channel_names, channels, denoised_channels):
        channel_metrics = calculate_quality_metrics(raw_ch, den_ch)
        channel_metrics['Channel'] = ch_name
        metrics.append(channel_metrics)
        all_channel_metrics.append(channel_metrics)
    
    # Calculate overall image metrics (average across channels)
    image_metrics = {
        'psnr': np.mean([m['psnr'] for m in all_channel_metrics]),
        'ssim': np.mean([m['ssim'] for m in all_channel_metrics]),
        'mse': np.mean([m['mse'] for m in all_channel_metrics]),
        'ncc': np.mean([m['ncc'] for m in all_channel_metrics]),
        'ssim_channels': [m['ssim'] for m in all_channel_metrics]
    }
    
    return denoised_channels, metrics, image_metrics

def process_directory(input_dir: str, output_dir: str, config_params: Dict, model_name: str = "N2V_merged"):
    """
    Batch process all TIFF images in directory using N2V denoising.
    
    Args:
        input_dir (str): Directory containing input TIFF images
        output_dir (str): Directory for denoised outputs and metrics
        config_params (dict): N2V training configuration parameters
        model_name (str): Base name for trained models
    """
    input_path = Path(input_dir)
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    
    # Get all TIFF files in the input directory
    tiff_files = list(input_path.glob("*.tif")) + list(input_path.glob("*.tiff"))
    
    if not tiff_files:
        print(f"No TIFF files found in {input_dir}")
        return
    
    all_metrics = []
    image_level_metrics = []
    
    for file_path in tiff_files:
        try:
            print(f"\nProcessing {file_path.name}...")
            
            with warnings.catch_warnings():
                warnings.simplefilter("ignore")
                image_array = io.imread(file_path)
            
            # Process with N2V
            denoised_channels, channel_metrics, image_metrics = process_single_image_n2v(
                image_array, 
                config_params,
                model_name=f"{model_name}_{file_path.stem}"
            )
            
            for metric in channel_metrics:
                metric['Filename'] = file_path.name
            all_metrics.extend(channel_metrics)
            
            image_metrics['Filename'] = file_path.name
            image_level_metrics.append(image_metrics)
            
            save_metrics_to_txt(image_metrics, output_path / "denoising_metrics.txt")
            
            print(f"Completed {file_path.name}")
            
        except Exception as e:
            print(f"Error processing {file_path.name}: {str(e)}")
            import traceback
            traceback.print_exc()
    
    if all_metrics:
        metrics_df = pd.DataFrame(all_metrics)
        metrics_df = metrics_df[['Filename', 'Channel', 'psnr', 'ssim', 'mse', 'ncc']]
        metrics_df.to_csv(output_path / "denoising_metrics.csv", index=False)
        print(f"\nSaved all channel metrics to {output_path}/denoising_metrics.csv")
    
    if image_level_metrics:
        save_summary_to_txt(image_level_metrics, output_path / "denoising_summary.txt")
        print(f"Saved summary to {output_path}/denoising_summary.txt")

